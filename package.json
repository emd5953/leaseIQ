{
  "name": "leaseiq",
  "version": "1.0.0",
  "description": "LeaseIQ rental platform database layer",
  "main": "dist/server.js",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "build": "tsc && echo 'Build completed successfully'",
    "prebuild": "echo 'Starting TypeScript compilation...'",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:connection": "tsx tests/test-connection.ts",
    "test:resend": "tsx tests/test-resend-email.ts",
    "test:reducto": "tsx tests/test-reducto-pdf.ts",
    "test:workflow": "tsx tests/quick-test.ts",
    "test:workflow-full": "tsx tests/quick-test.ts",
    "test:combined": "tsx tests/test-combined-analysis.ts",
    "dev": "node scripts/dev.cjs",
    "start": "node dist/server.js",
    "start:backend": "tsx src/server.ts",
    "start:frontend": "cd frontend && npm run dev",
    "start:fullstack": "node scripts/dev.cjs",
    "server": "node dist/server.js",
    "alerts": "tsx src/jobs/alert-cron.ts",
    "scraping": "tsx src/jobs/scraping-cron.ts",
    "scrape": "tsx src/ingestion/example.ts",
    "test:reliability": "vitest run tests/reliability tests/unit/listing-validation.test.ts tests/unit/queries.test.ts tests/properties/schema-conformance.properties.test.ts src/ingestion/models/listing.schema.test.ts",
    "validate:research": "tsx scripts/validate-research.ts",
    "audit:listings": "tsx scripts/audit-listings.ts",
    "repair:listings": "tsx scripts/repair-listings.ts",
    "verify:listings": "tsx scripts/verify-listings.ts",
    "dev:api": "tsx src/server.ts",
    "test:e2e": "playwright test",
    "test:dev": "node scripts/check-dev-lifecycle.cjs",
    "validate:listing-flow": "tsx scripts/validate-listing-flow.ts"
  },
  "keywords": [
    "rental",
    "apartment",
    "database"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.93.3",
    "@types/multer": "^2.0.0",
    "bottleneck": "^2.19.5",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^10.5.0",
    "ipaddr.js": "^2.5.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.21.0",
    "mongoose": "^8.0.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "openai": "^6.17.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/node-cron": "^3.0.11",
    "fast-check": "^4.5.3",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
