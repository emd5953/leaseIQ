# Copy to .env. Blank services remain explicitly unavailable; no sample rentals are inserted.
PORT=3001
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
MONGODB_URI=
# Generate a private random key (at least 32 characters). Required in production.
JWT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Separate server-only credential for POST /api/alerts/process; cron CLI needs no HTTP token.
INTERNAL_JOB_TOKEN=
OPENROUTER_API_KEY=
REDUCTO_API_KEY=
RESEND_API_KEY=
# Prefer RESEND_FROM_EMAIL; EMAIL_FROM remains a compatibility alias.
RESEND_FROM_EMAIL=
EMAIL_FROM=
FIRECRAWL_API_KEY=
GOOGLE_GEOCODING_API_KEY=
